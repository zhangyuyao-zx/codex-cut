{
  "id": "transcript-workflow",
  "label": "口播转写与同步粗剪",
  "entry": "TranscriptWorkflow.tsx",
  "exportName": "TranscriptWorkflow",
  "controls": [
    {
      "key": "background",
      "label": "背景色",
      "type": "color",
      "default": "#171b1e"
    },
    {
      "key": "textColor",
      "label": "文字颜色",
      "type": "color",
      "default": "#f2f0e9"
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "default": "#e1f795"
    },
    {
      "key": "introTitle",
      "label": "导入标题",
      "type": "text",
      "default": "从一段口播"
    },
    {
      "key": "transcriptTitle",
      "label": "转写标题",
      "type": "text",
      "default": "说过的话，"
    },
    {
      "key": "alignTitle",
      "label": "对齐标题",
      "type": "text",
      "default": "每一个字，"
    },
    {
      "key": "editTitle",
      "label": "剪辑标题",
      "type": "text",
      "default": "删掉文字，"
    },
    {
      "key": "transcript",
      "label": "逐字稿展示（空格分组）",
      "type": "text",
      "default": "导入 一段 口播 视频"
    },
    {
      "key": "keptLine",
      "label": "保留句",
      "type": "text",
      "default": "我们的目标很简单。"
    },
    {
      "key": "repeatedLine",
      "label": "重复句",
      "type": "text",
      "default": "我们的目标很简单。"
    },
    {
      "key": "titleSize",
      "label": "标题字号",
      "type": "number",
      "default": 70,
      "min": 40,
      "max": 90
    },
    {
      "key": "wordSize",
      "label": "逐字稿字号",
      "type": "number",
      "default": 45,
      "min": 28,
      "max": 56
    },
    {
      "key": "personScale",
      "label": "人物大小",
      "type": "number",
      "default": 1,
      "min": 0.6,
      "max": 1.3
    },
    {
      "key": "personX",
      "label": "人物水平位置",
      "type": "number",
      "default": 0,
      "min": -80,
      "max": 100
    },
    {
      "key": "personY",
      "label": "人物垂直位置",
      "type": "number",
      "default": 0,
      "min": -100,
      "max": 100
    }
  ],
  "objects": [
    {
      "id": "person",
      "label": "人物画面",
      "parameters": [
        "personScale",
        "personX",
        "personY"
      ]
    },
    {
      "id": "headline",
      "label": "阶段标题",
      "parameters": [
        "introTitle",
        "transcriptTitle",
        "alignTitle",
        "editTitle",
        "titleSize",
        "accent",
        "textColor",
        "background"
      ]
    },
    {
      "id": "transcript",
      "label": "逐字稿",
      "parameters": [
        "transcript",
        "wordSize",
        "keptLine",
        "repeatedLine"
      ]
    },
    {
      "id": "timeline",
      "label": "时间线",
      "parameters": [
        "accent"
      ]
    }
  ]
}