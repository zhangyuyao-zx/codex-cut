{
  "id": "talking-head-story",
  "label": "口播全片叙事",
  "entry": "TalkingHeadStory.tsx",
  "exportName": "TalkingHeadStory",
  "controls": [
    {
      "key": "background",
      "label": "背景色",
      "type": "color",
      "default": "#171b1e"
    },
    {
      "key": "textColor",
      "label": "文字颜色",
      "type": "color",
      "default": "#f2f0e9"
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "default": "#e1f795"
    },
    {
      "key": "headline",
      "label": "标题",
      "type": "text",
      "default": ""
    },
    {
      "key": "labels",
      "label": "重点文字（用竖线分隔）",
      "type": "text",
      "default": ""
    },
    {
      "key": "titleSize",
      "label": "标题字号",
      "type": "number",
      "default": 77,
      "min": 40,
      "max": 96
    },
    {
      "key": "personScale",
      "label": "人物大小",
      "type": "number",
      "default": 1,
      "min": 0.6,
      "max": 1.3
    },
    {
      "key": "personX",
      "label": "人物水平位置",
      "type": "number",
      "default": 0,
      "min": -80,
      "max": 100
    },
    {
      "key": "personY",
      "label": "人物垂直位置",
      "type": "number",
      "default": 0,
      "min": -100,
      "max": 100
    }
  ],
  "objects": [
    {
      "id": "person",
      "label": "人物画面",
      "parameters": [
        "personScale",
        "personX",
        "personY"
      ]
    },
    {
      "id": "headline",
      "label": "段落标题",
      "parameters": [
        "headline",
        "titleSize",
        "accent",
        "textColor",
        "background"
      ]
    },
    {
      "id": "graphics",
      "label": "解释画面",
      "parameters": [
        "labels",
        "accent"
      ]
    }
  ]
}