{
  "name": "codex-cut-workbench",
  "version": "0.3.2",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node workbench-local/launcher.mjs start",
    "stop": "node workbench-local/launcher.mjs stop",
    "status": "node workbench-local/launcher.mjs status",
    "dev": "tsx workbench-local/server.ts",
    "render:readme-demo": "tsx scripts/render-readme-demo.ts",
    "typecheck": "tsc -p workbench-local/tsconfig.json",
    "test": "vitest run --config workbench-local/vitest.config.ts",
    "dots": "node tools/dots-production/cli.mjs",
    "test:authoring": "node tools/dots-production/test.mjs && python3 -B -m unittest discover -s tools/reference-study -p 'test_*.py' -v",
    "test:plugin": "node --test workbench-local/plugin-package/codex-cut/scripts/bridge.test.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.489",
    "@remotion/player": "4.0.489",
    "@remotion/renderer": "4.0.489",
    "@remotion/three": "4.0.489",
    "@types/express": "5.0.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "esbuild": "0.28.2",
    "express": "5.1.0",
    "immer": "10.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.489",
    "supertest": "7.1.4",
    "three": "0.186.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.11",
    "zod": "4.3.6"
  }
}
